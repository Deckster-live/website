// Cloudflare Worker that only serves the static export in out/ (no server code).
// Without this file `wrangler deploy` treats the app as server-rendered Next.js and the OpenNext build fails.
{
  "name": "website",
  "compatibility_date": "2026-06-01",
  // Served only on deckster.live (custom domain), so the *.workers.dev copy can't be indexed as a duplicate.
  "workers_dev": false,
  "assets": {
    "directory": "./out",
    // Serve out/404.html (with a 404 status) for unknown paths.
    "not_found_handling": "404-page"
  }
}
